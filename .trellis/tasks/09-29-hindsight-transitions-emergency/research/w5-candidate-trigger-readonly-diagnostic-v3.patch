+def write_result(path: Path, report: dict[str, Any]) -> None:
+    """Keep cleanup facts durable when diagnostic payload encoding fails."""
+    try:
+        encoded = json.dumps(report, indent=2, allow_nan=False)
+    except (TypeError, ValueError) as error:
+        # Do not stringify arbitrary payloads or exception messages. Retain the
+        # first diagnostic failure; an encoding-only failure must also make the
+        # inherited main's success gate fail after its cleanup has completed.
+        report["reportEncodingFailed"] = True
+        report["reportEncodingErrorClass"] = "TypeError" if isinstance(error, TypeError) else "ValueError"
+        report.setdefault("errorClass", "ReportSerializationError")
+        known_errors = {
+            "AssertionError",
+            "TypeError",
+            "ValueError",
+            "TimeoutError",
+            "RuntimeError",
+            "CancelledError",
+            "OSError",
+            "KeyboardInterrupt",
+            "ReportSerializationError",
+        }
+        original_error = report["errorClass"]
+        fallback = {
+            "meaning": "Diagnostic report encoding failed; only closed failure and preservation facts retained.",
+            "root": str(path.parent),
+            "reportEncodingFailed": True,
+            "reportEncodingErrorClass": report["reportEncodingErrorClass"],
+            "errorClass": original_error
+            if isinstance(original_error, str) and original_error in known_errors
+            else "OtherError",
+        }
+        # The outer finally calls this again after source/port verification.
+        # Preserve its latest booleans without inventing success for absent or
+        # malformed facts. The failed payload is deliberately never persisted.
+        for key in (
+            "started",
+            "stopped",
+            "sourcePreserved",
+            "inputPreserved",
+            "corePreserved",
+            "originalPreserved",
+            "readerSourcesPreserved",
+            "portReleased",
+            "diagnosticCompleted",
+        ):
+            value = report.get(key)
+            fallback[key] = value if isinstance(value, bool) else None
+        encoded = json.dumps(fallback, indent=2, allow_nan=False)
+    # Encode completely before opening the file; a payload failure must not
+    # truncate the preceding report. Filesystem failures remain explicit.
+    path.write_text(encoded + "\n", encoding="utf-8")
+
+
