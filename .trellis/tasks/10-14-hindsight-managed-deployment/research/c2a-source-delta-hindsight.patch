diff --git a/docker/standalone/tests/fixtures/c2a_pipe_owner.py b/docker/standalone/tests/fixtures/c2a_pipe_owner.py
new file mode 100644
index 0000000..127639a
--- /dev/null
+++ b/docker/standalone/tests/fixtures/c2a_pipe_owner.py
@@ -0,0 +1,63 @@
+"""Test-parent-owned finite C2a owner; anonymous pipes are not a release transport.
+
+Control and credential input are distinct operations. This driver never creates
+a grant by itself, and the real fixed consumer remains in managed_bootstrap.
+"""
+
+from __future__ import annotations
+
+import io
+import sys
+import threading
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+
+from managed_bootstrap.owner import C2BootstrapOwner
+from managed_bootstrap.protocol import PRIVATE_BYTES, Reason, Refusal, encode_status, packet, read_packet
+
+
+def main() -> int:
+    root = Path(sys.argv[1])
+    if (root / ".c2a-owned-fixture").read_text(encoding="utf-8") != "C2A_FAKE_ONLY":
+        return 2
+    owner = C2BootstrapOwner(sys.argv[2], root)
+    timer = threading.Timer(180, owner.close)
+    timer.daemon = True
+    timer.start()
+    try:
+        write(owner)
+        while True:
+            message = read_packet(sys.stdin.buffer, PRIVATE_BYTES + 5, eof=False)
+            if not message:
+                raise Refusal(Reason.DENIED)
+            try:
+                if message[0] == 1:
+                    owner.control(message[1:])
+                elif message[0] == 2:
+                    payload = read_packet(io.BytesIO(message[1:]), PRIVATE_BYTES, eof=True)
+                    owner.bootstrap.accept(payload)
+                elif message == b"\x03":
+                    owner.close()
+                    write(owner)
+                    return 0
+                else:
+                    raise Refusal(Reason.DENIED)
+                write(owner)
+            except Refusal as error:
+                write(owner, error.reason)
+    except (Refusal, BrokenPipeError):
+        return 1
+    finally:
+        timer.cancel()
+        owner.close()
+
+
+def write(owner: C2BootstrapOwner, reason: Reason | None = None) -> None:
+    status = owner.bootstrap.refusal(reason) if reason is not None else owner.bootstrap.status()
+    sys.stdout.buffer.write(packet(encode_status(status)))
+    sys.stdout.buffer.flush()
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/docker/standalone/tests/test_c2a_bootstrap_owner.py b/docker/standalone/tests/test_c2a_bootstrap_owner.py
new file mode 100644
index 0000000..1fc4341
--- /dev/null
+++ b/docker/standalone/tests/test_c2a_bootstrap_owner.py
@@ -0,0 +1,137 @@
+from __future__ import annotations
+
+import json
+import secrets
+import sys
+import tempfile
+import time
+import unittest
+import uuid
+from dataclasses import replace
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+from managed_bootstrap.owner import C2BootstrapOwner
+from managed_bootstrap.owner_protocol import CONTROL_BYTES, parse_owner_request
+from managed_bootstrap.protocol import Credential, PrivateFrame, Refusal, Slot, encode_private, encode_status
+from test_managed_bootstrap_process import pid_alive
+from test_managed_bootstrap_protocol import fixture_binding
+
+
+def fake_frame(owner: C2BootstrapOwner, seconds: float = 30) -> PrivateFrame:
+    return PrivateFrame(
+        fixture_binding(owner.bootstrap.startup_id, seconds),
+        tuple(Credential(slot, "catalog", "C2A_FAKE_" + secrets.token_hex(32)) for slot in Slot),
+    )
+
+
+def permit(frame: PrivateFrame) -> bytes:
+    binding = frame.binding
+    return json.dumps(
+        {
+            "version": 1,
+            "action": "authorize",
+            "permit": {
+                "version": 1,
+                "checkpointId": str(uuid.uuid4()),
+                "binding": {
+                    "startupId": binding.startup_id,
+                    "configurationDigest": binding.configuration_digest,
+                    "operationId": binding.operation_id,
+                    "attemptId": binding.attempt_id,
+                    "authorizationId": binding.authorization_id,
+                    "deadlineAt": binding.deadline_at,
+                },
+                "selection": [{"slot": entry.slot, "source": entry.source} for entry in frame.credentials],
+            },
+        }
+    ).encode()
+
+
+class C2aOwnerTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.temporary = tempfile.TemporaryDirectory(prefix="taki-c2a-native-")
+        self.root = Path(self.temporary.name)
+        (self.root / ".env").write_text("C2A_DOTENV_POISON=must_not_load\n", encoding="utf-8")
+        self.owner = C2BootstrapOwner("a" * 64, self.root)
+
+    def tearDown(self) -> None:
+        self.owner.close()
+        self.temporary.cleanup()
+
+    def test_real_child_requires_independent_control_and_remains_observable_after_expiry(self) -> None:
+        frame = fake_frame(self.owner, 2)
+        with self.assertRaises(Refusal):
+            self.owner.bootstrap.accept(encode_private(frame))
+        self.assertFalse((self.root / "c2a-child.json").exists())
+        granted = self.owner.control(permit(frame))
+        self.assertEqual(granted.state, "waiting-for-credentials")
+        result = self.owner.bootstrap.accept(encode_private(frame))
+        self.assertEqual(result.state, "running")
+        marker = json.loads((self.root / "c2a-child.json").read_text(encoding="utf-8"))
+        self.assertTrue(pid_alive(marker["pid"]))
+        with self.assertRaises(Refusal):
+            self.owner.control(permit(frame))
+        with self.assertRaises(Refusal):
+            self.owner.bootstrap.accept(encode_private(frame))
+        time.sleep(2.05)
+        observed = self.owner.control(b'{"version":1,"action":"status"}')
+        self.assertEqual(observed.state, "running")
+        self.assertEqual(observed.binding, frame.binding)
+        for entry in frame.credentials:
+            assert entry.value is not None
+            self.assertNotIn(entry.value.encode(), encode_status(observed))
+            for path in self.root.iterdir():
+                self.assertNotIn(entry.value.encode(), path.read_bytes())
+        self.owner.close()
+        self.assertFalse(pid_alive(marker["pid"]))
+
+    def test_native_independently_rejects_every_non_fake_selected_value(self) -> None:
+        for slot in Slot:
+            with self.subTest(slot=slot):
+                self.owner.close()
+                self.owner = C2BootstrapOwner("a" * 64, self.root)
+                frame = fake_frame(self.owner)
+                frame = replace(
+                    frame,
+                    credentials=tuple(
+                        replace(entry, value="GENERATED_NONMATCHING_TEST_VALUE") if entry.slot == slot else entry
+                        for entry in frame.credentials
+                    ),
+                )
+                self.owner.control(permit(frame))
+                with self.assertRaises(Refusal):
+                    self.owner.bootstrap.accept(encode_private(frame))
+                self.assertFalse((self.root / "c2a-child.json").exists())
+
+    def test_wrong_startup_configuration_selection_or_expiry_cannot_start_child(self) -> None:
+        frame = fake_frame(self.owner)
+        for binding in (
+            replace(frame.binding, startup_id=str(uuid.uuid4())),
+            replace(frame.binding, configuration_digest="f" * 64),
+            fixture_binding(self.owner.bootstrap.startup_id, -1),
+        ):
+            with self.assertRaises(Refusal):
+                self.owner.control(permit(replace(frame, binding=binding)))
+        self.owner.control(permit(frame))
+        with self.assertRaises(Refusal):
+            self.owner.bootstrap.accept(encode_private(replace(frame, credentials=frame.credentials[:1])))
+        self.assertFalse((self.root / "c2a-child.json").exists())
+
+    def test_control_is_bounded_strict_and_never_accepts_frame_as_its_own_authority(self) -> None:
+        for payload in (
+            b"null",
+            b"\xff",
+            b'{"version":1,"action":"reset"}',
+            b'{"version":1,"version":1,"action":"status"}',
+            b'{"version":1,"action":"status","permit":null}',
+            encode_private(fake_frame(self.owner)),
+            b" " * (CONTROL_BYTES + 1),
+        ):
+            with self.subTest(size=len(payload)), self.assertRaises(Refusal):
+                parse_owner_request(payload)
+
+
+if __name__ == "__main__":
+    unittest.main()
