+
+function sourceContext(fact: RunTerminalFact, source?: SourceContext, subagentId?: string): SourceContext {
+  return { ...source, generatedBy: { runId: fact.run.runId, attemptId: fact.attempt.attemptId, ...(subagentId ? { subagentId } : {}) } };
+}
