{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "pet",
  "description": "Pet overlay window: drag, show-after-first-paint, position persistence, window events, per-pixel click-through (cursor position + ignore-cursor-events); opens/navigates the home window on demand",
  "windows": ["pet"],
  "permissions": [
    "core:event:default",
    "core:path:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-position",
    "core:window:allow-outer-position",
    "core:window:allow-show",
    "core:window:allow-set-ignore-cursor-events",
    "core:window:allow-cursor-position",
    "core:window:allow-inner-position",
    "core:window:allow-scale-factor",
    "core:window:allow-set-focus",
    "core:window:allow-get-all-windows",
    "core:webview:allow-get-all-webviews",
    "core:webview:allow-create-webview-window",
    "window-state:default"
  ]
}
