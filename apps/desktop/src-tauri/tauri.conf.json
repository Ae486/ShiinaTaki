{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TakiAgent",
  "version": "0.0.0",
  "identifier": "cc.shiinataki.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "home",
        "url": "home.html",
        "title": "TakiAgent",
        "width": 1120,
        "height": 760,
        "resizable": true
      },
      {
        "label": "pet",
        "url": "pet.html",
        "title": "TakiAgent Pet",
        "width": 480,
        "height": 640,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost ws://127.0.0.1:* ws://localhost:* ws://[::1]:*",
        "img-src": "'self' asset: http://asset.localhost blob: data: https://models.dev",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
