{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TakiAgent",
  "version": "0.0.0",
  "identifier": "cc.shiinataki.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TakiAgent",
        "width": 480,
        "height": 640,
        "resizable": true
      },
      {
        "label": "pet",
        "url": "pet.html",
        "title": "TakiAgent Pet",
        "width": 480,
        "height": 640,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
